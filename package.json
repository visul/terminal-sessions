{
  "name": "terminal-sessions",
  "displayName": "Terminal Sessions",
  "description": "Persistent terminal sessions for Cursor/VSCode via tmux — survive editor restart, workspace-scoped. Live AI-agent status in the sidebar for Claude Code, Codex, Antigravity, and Grok: working/tool/waiting state, context-window %, cost, last user/assistant messages. Browse, view, name, resume, and clean up every past conversation on your machine.",
  "version": "0.20.32",
  "publisher": "visul",
  "license": "MIT",
  "icon": "media/extension-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/visul/terminal-sessions.git"
  },
  "bugs": {
    "url": "https://github.com/visul/terminal-sessions/issues"
  },
  "homepage": "https://github.com/visul/terminal-sessions#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "terminal",
    "tmux",
    "sessions",
    "persistent",
    "claude",
    "claude-code",
    "cursor",
    "resume"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Terminal Sessions",
      "properties": {
        "terminalSessions.tmuxPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to tmux binary. Leave empty to autodetect from common locations and PATH."
        },
        "terminalSessions.sessionPrefix": {
          "type": "string",
          "default": "ts",
          "description": "Prefix for all tmux session names created by this extension."
        },
        "terminalSessions.enabledAgents": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "claude",
              "codex",
              "agy",
              "grok"
            ]
          },
          "default": [],
          "markdownDescription": "Which AI CLIs to track in the sidebar (status, context %, auto-resume, notifications). Leave empty to auto-detect: Claude is always on; Codex, Antigravity (`agy`) and Grok turn on when their CLI is found on PATH. Set explicitly to override, e.g. `[\"claude\", \"codex\"]`."
        },
        "terminalSessions.autoRestore": {
          "type": "string",
          "enum": [
            "auto",
            "ask",
            "off"
          ],
          "default": "ask",
          "description": "Behavior when opening a workspace that has detached sessions: auto-resume all, ask via toast, or off."
        },
        "terminalSessions.autoRestoreMaxAgeHours": {
          "type": "number",
          "default": 72,
          "description": "Skip auto-restore for sessions untouched longer than this (hours)."
        },
        "terminalSessions.pruneAfterDays": {
          "type": "number",
          "default": 14,
          "description": "Offer to prune sessions untouched longer than this (days). Set to 0 to disable."
        },
        "terminalSessions.enableCostTracker": {
          "type": "boolean",
          "default": false,
          "description": "Reserved. Cost tracking was removed in v0.4.2 (API rate card was misleading for Max/Team plan users). Tokens usage is still available via Claude's own `claude /status` command."
        },
        "terminalSessions.enableLongRunNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Notify when a terminal command takes longer than the threshold."
        },
        "terminalSessions.longRunThresholdSeconds": {
          "type": "number",
          "default": 30,
          "description": "Minimum duration (seconds) for long-run command notifications."
        },
        "terminalSessions.nativeNotifications": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "default": "auto",
          "description": "macOS Notification Center behavior. auto = native when Cursor unfocused, toast when focused; always = always native; never = only VS Code toast."
        },
        "terminalSessions.notificationSound": {
          "type": "string",
          "enum": [
            "Basso",
            "Blow",
            "Bottle",
            "Frog",
            "Funk",
            "Glass",
            "Hero",
            "Morse",
            "Ping",
            "Pop",
            "Purr",
            "Sosumi",
            "Submarine",
            "Tink"
          ],
          "default": "Glass",
          "description": "Default sound for native notifications (macOS built-in sounds). Errors override with Basso."
        },
        "terminalSessions.notifyOnClaudeStop": {
          "type": "boolean",
          "default": true,
          "description": "Send a notification when Claude Code finishes a response. Requires Claude hook installed."
        },
        "terminalSessions.notifyOnClaudeWaiting": {
          "type": "boolean",
          "default": true,
          "description": "Send a notification when Claude Code blocks waiting for your permission (tool approval, risky command, etc.). Distinct sound from the `done` notification so you can tell them apart at a glance."
        },
        "terminalSessions.waitingAlertStyle": {
          "type": "string",
          "enum": [
            "banner",
            "alert"
          ],
          "enumDescriptions": [
            "Banner notification that auto-dismisses after a few seconds (system default).",
            "Persistent modal alert dialog in the macOS foreground with a `Show terminal` button. Blocks until you dismiss — use only if you miss the banners."
          ],
          "default": "banner",
          "description": "How to surface Claude waiting-for-permission events."
        },
        "terminalSessions.notificationSoundWaiting": {
          "type": "string",
          "enum": [
            "Basso",
            "Blow",
            "Bottle",
            "Frog",
            "Funk",
            "Glass",
            "Hero",
            "Morse",
            "Ping",
            "Pop",
            "Purr",
            "Sosumi",
            "Submarine",
            "Tink"
          ],
          "default": "Sosumi",
          "description": "Sound for `Claude needs approval` waiting notifications. Defaults to Sosumi so it is distinct from the `done` sound."
        },
        "terminalSessions.claudeStopMinDurationSeconds": {
          "type": "number",
          "default": 15,
          "description": "Only notify on Claude Stop if session has been running at least N seconds (avoids notif-storm on short turns)."
        },
        "terminalSessions.autoResumeClaude": {
          "type": "boolean",
          "default": false,
          "description": "After recreating sessions post-reboot, auto-run `claude --resume <id>` in the attached terminal. OFF by default because it can accidentally send text into a running Claude process. Safer: let the summary toast hint you the command and run it manually."
        },
        "terminalSessions.contextWarnPct": {
          "type": "number",
          "default": 0.8,
          "minimum": 0,
          "maximum": 1,
          "description": "Show a context-window warning badge (e.g. `87% ctx`) next to the Claude state when the latest turn crossed this percentage of the model's context limit. Set to 1 to disable the badge. Default 0.8 = warn at 80%."
        },
        "terminalSessions.claudeSidebarDetails": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "collapsed",
            "off"
          ],
          "enumDescriptions": [
            "Expand Claude details (last message, tool, model, tokens) only while Claude is actively working or needs input.",
            "Always show Claude details as nested rows under every session that has a Claude history.",
            "Show Claude details as a collapsible row but keep it collapsed by default — nothing auto-expands; click the chevron to reveal details when you want them, and they stay where you leave them.",
            "Never show Claude details as nested rows. Info stays in the tooltip."
          ],
          "default": "auto",
          "description": "Show per-session Claude Code details (last user/assistant message, current tool, model, tokens) as nested rows in the sidebar. Requires the Claude hook to be installed."
        },
        "terminalSessions.showCompletedSubagents": {
          "type": "boolean",
          "default": true,
          "description": "Show subagents that have already finished (Task tool_result received) in the sidebar. On by default so short-running agents don't flicker in and out; flip to false if the tree gets too busy in sessions with many completed agents."
        },
        "terminalSessions.revealActiveSession": {
          "type": "boolean",
          "default": true,
          "description": "When you focus a terminal, highlight (select) its matching session in the sidebar so it's easy to locate among many tabs. This only selects an already-visible row — it never expands a collapsed group or scrolls to a hidden one. Set to false if you don't want the sidebar selection to follow the active terminal."
        },
        "terminalSessions.confirmYoloSwitch": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before switching a session into YOLO mode, where the agent stops asking you to approve tool use, file writes and shell commands. Switching back to normal mode is never gated. A session that is actively working is always confirmed regardless of this setting, since restarting interrupts it."
        },
        "terminalSessions.claudeNoFlicker": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "enumDescriptions": [
            "Default: on everywhere. Claude renders in clean alt-screen so the mouse wheel scrolls the conversation natively (smooth); you can still drag-select/copy the visible text (tmux pipes the selection through pbcopy/xclip, correct UTF-8).",
            "Always set CLAUDE_CODE_NO_FLICKER=1: same as auto — clean alt-screen + native wheel scroll, drag-copy of the visible screen via pbcopy/xclip.",
            "Never set it: classic renderer, the whole conversation lands in tmux scrollback (selectable), but the wheel drops into tmux copy-mode instead of scrolling Claude; some flicker on heavy redraws."
          ],
          "default": "auto",
          "markdownDescription": "Controls `CLAUDE_CODE_NO_FLICKER` in the managed tmux.conf. **`auto`** (default) now sets it **on everywhere**: Claude renders in clean alt-screen so the mouse wheel scrolls the conversation natively, and you can still drag-select/copy the visible text — tmux pipes the selection through pbcopy/xclip (correct UTF-8), so copy no longer depends on Claude's OSC 52. **`on`** = same as auto. **`off`** = classic renderer; the whole conversation is in tmux scrollback (selectable) but the wheel goes to tmux copy-mode instead of scrolling Claude. Changing this regenerates and reloads tmux.conf; restart any running Claude session (sidebar → Restart) to apply."
        },
        "terminalSessions.sidebarSortMode": {
          "type": "string",
          "enum": [
            "custom",
            "mru",
            "created",
            "alphabetical"
          ],
          "enumDescriptions": [
            "User-defined order — drag sessions in the sidebar to rearrange; persisted across restarts.",
            "Most recently focused session first.",
            "Creation order (oldest first) — default.",
            "Alphabetical by session label."
          ],
          "default": "created",
          "description": "How to sort sessions under each workspace in the sidebar. Click the list-ordered icon in the sidebar title bar to switch modes interactively. Dragging a session switches automatically to 'custom'."
        },
        "terminalSessions.sidebarFilterMode": {
          "type": "string",
          "enum": [
            "all",
            "running",
            "stopped"
          ],
          "enumDescriptions": [
            "Show every session (running + stopped).",
            "Hide stopped sessions.",
            "Show only stopped sessions."
          ],
          "default": "all",
          "description": "Filter the sidebar by session state. Click the filter icon in the sidebar title bar to switch interactively."
        },
        "terminalSessions.showActivityFolder": {
          "type": "boolean",
          "default": true,
          "description": "Show the pinned \"Sessions Activity\" folder at the top of each workspace: a flat list of sessions ordered by recency (running first, then most recently stopped). Toggle also available in the view's ⋯ menu."
        },
        "terminalSessions.showKilledFolder": {
          "type": "boolean",
          "default": true,
          "description": "Show the pinned \"Sessions Killed\" folder: recently killed sessions kept in a graveyard so they can be restored (right-click → Restore Session). Hidden while empty. Toggle also available in the view's ⋯ menu."
        },
        "terminalSessions.activityLimit": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "Maximum sessions listed in the Sessions Activity folder."
        },
        "terminalSessions.killedLimit": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "Maximum killed sessions kept in the graveyard (older entries fall off as new kills arrive)."
        }
      }
    },
